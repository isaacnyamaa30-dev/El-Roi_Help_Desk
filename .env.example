# ============================================================================
#  EL-ROI Help Desk Tracker — environment variables
#  Copy this file to `.env` and fill in the values from your Supabase project
#  (Project Settings -> API). Never commit `.env`.
# ============================================================================

# --- Frontend (safe to expose in the browser bundle) ------------------------
# Vite only exposes variables prefixed with VITE_.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Seed script ONLY (local use — never exposed to the browser) ------------
# Project Settings -> API -> service_role secret. Keep this out of git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
